import Mathlib.Combinatorics.SimpleGraph.Cayley
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Algebra.Group.Subgroup.Lattice
import EvalTools.Markers

namespace LeanEval
namespace Combinatorics

/-!
A Cayley graph is connected if and only if its generators generate the group.

The Cayley graph of a group `G` with generators `S` has vertex set `G` and an edge between
`x` and `y` whenever `x * g = y` for some `g ∈ S`. This theorem characterises connectivity:
the Cayley graph is connected if and only if `S` generates `G` as a group. The forward
direction constructs a path from `1` to any `g ∈ G` via the generators; the reverse shows
that any path in the graph corresponds to a product of generators.

This is a foundational result in geometric group theory, connecting algebraic generation
to graph-theoretic connectivity.

The underlying graph `SimpleGraph.mulCayley` (blueprint `def:cayley`) is already part of
Mathlib, so it is not re-defined here.
-/

variable {G : Type*} [Group G] (S : Set G)

/-- **Adjacency in the Cayley graph.** For `a, b ∈ G`, the vertices `a` and `b` are adjacent
in `mulCayley S` iff `a ≠ b` and there is a generator `g ∈ S` with `a * g = b` or `b * g = a`. -/
theorem mulCayley_adj_iff (a b : G) :
    (SimpleGraph.mulCayley S).Adj a b ↔
      a ≠ b ∧ ((∃ g ∈ S, a * g = b) ∨ ∃ g ∈ S, b * g = a) := by
  simpa [exists_or, and_or_left, eq_comm] using SimpleGraph.mulCayley_adj' S a b

/-- **Left translation preserves adjacency.** If `a` and `b` are adjacent in `mulCayley S`,
then so are `h * a` and `h * b`. -/
theorem mulCayley_adj_mul_left (h a b : G)
    (hab : (SimpleGraph.mulCayley S).Adj a b) :
    (SimpleGraph.mulCayley S).Adj (h * a) (h * b) := by
  rw [SimpleGraph.mulCayley_adj] at hab ⊢
  rcases hab with ⟨hne, hmem⟩
  refine ⟨?_, ?_⟩
  · intro h_eq
    exact hne (mul_left_cancel h_eq)
  · rcases hmem with (h | h)
    · left
      simpa [mul_assoc, mul_inv_rev] using h
    · right
      simpa [mul_assoc, mul_inv_rev] using h

/-- **Left translation preserves reachability.** If `b` is reachable from `a` in `mulCayley S`,
then `h * b` is reachable from `h * a`. -/
theorem mulCayley_reachable_mul_left (h a b : G)
    (hab : (SimpleGraph.mulCayley S).Reachable a b) :
    (SimpleGraph.mulCayley S).Reachable (h * a) (h * b) := by
  let f : (SimpleGraph.mulCayley S) →g (SimpleGraph.mulCayley S) :=
    { toFun := fun x => h * x
      map_rel' := mulCayley_adj_mul_left S h _ _ }
  exact SimpleGraph.Reachable.map f hab

/-- **Adjacent vertices differ by a generator.** If `a` and `b` are adjacent in `mulCayley S`,
then `a⁻¹ * b` lies in the subgroup generated by `S`. -/
theorem mulCayley_inv_mul_mem_closure_of_adj (a b : G)
    (hab : (SimpleGraph.mulCayley S).Adj a b) :
    a⁻¹ * b ∈ Subgroup.closure S := by
  rcases (SimpleGraph.mulCayley_adj S a b).mp hab with ⟨h_ne, h_cases⟩
  rcases h_cases with (h | h)
  · exact Subgroup.subset_closure h
  · have h' : a⁻¹ * b = (b⁻¹ * a)⁻¹ := by
      simp [mul_inv_rev, inv_inv]
    rw [h']
    exact Subgroup.inv_mem _ (Subgroup.subset_closure h)

/-- **Reachability implies membership in the closure.** If `b` is reachable from `a` in
`mulCayley S`, then `a⁻¹ * b` lies in the subgroup generated by `S`. -/
theorem mulCayley_inv_mul_mem_closure_of_reachable (a b : G)
    (hab : (SimpleGraph.mulCayley S).Reachable a b) :
    a⁻¹ * b ∈ Subgroup.closure S := by
  have hRG : Relation.ReflTransGen (SimpleGraph.mulCayley S).Adj a b :=
    (SimpleGraph.reachable_iff_reflTransGen _ _).mp hab
  refine hRG.rec ?_ ?_
  · simp
  · intro mid c h h_adj ih
    have h_mem_c : mid⁻¹ * c ∈ Subgroup.closure S :=
      mulCayley_inv_mul_mem_closure_of_adj S mid c h_adj
    have h_eq : a⁻¹ * c = (a⁻¹ * mid) * (mid⁻¹ * c) := by
      calc
        a⁻¹ * c = a⁻¹ * (1 * c) := by simp
        _ = a⁻¹ * ((mid * mid⁻¹) * c) := by simp
        _ = (a⁻¹ * mid) * (mid⁻¹ * c) := by
          simp [mul_assoc]
    rw [h_eq]
    exact Subgroup.mul_mem _ ih h_mem_c

/-- **Generators are reachable from the identity.** For every `g ∈ S`, the vertex `g` is
reachable from `1` in `mulCayley S`. -/
theorem mulCayley_reachable_one_generator {g : G} (hg : g ∈ S) :
    (SimpleGraph.mulCayley S).Reachable 1 g := by
  by_cases h : g = 1
  · subst h
    exact SimpleGraph.Reachable.refl 1
  · have hne : (1 : G) ≠ g := Ne.symm h
    have adj : (SimpleGraph.mulCayley S).Adj 1 g := by
      rw [mulCayley_adj_iff]
      refine ⟨hne, Or.inl ?_⟩
      exact ⟨g, hg, by simp⟩
    exact adj.reachable

/-- **Reachability from `1` is closed under products.** If `x` and `y` are each reachable from
`1` in `mulCayley S`, then so is `x * y`. -/
theorem mulCayley_reachable_one_mul {x y : G}
    (hx : (SimpleGraph.mulCayley S).Reachable 1 x)
    (hy : (SimpleGraph.mulCayley S).Reachable 1 y) :
    (SimpleGraph.mulCayley S).Reachable 1 (x * y) := by
  have hx_mul : (SimpleGraph.mulCayley S).Reachable (x * 1) (x * y) :=
    mulCayley_reachable_mul_left S x 1 y hy
  have hx_mul' : (SimpleGraph.mulCayley S).Reachable x (x * y) := by
    simpa [mul_one] using hx_mul
  exact hx.trans hx_mul'

/-- **Reachability from `1` is closed under inverses.** If `x` is reachable from `1` in
`mulCayley S`, then so is `x⁻¹`. -/
theorem mulCayley_reachable_one_inv {x : G}
    (hx : (SimpleGraph.mulCayley S).Reachable 1 x) :
    (SimpleGraph.mulCayley S).Reachable 1 x⁻¹ := by
  have h := mulCayley_reachable_mul_left S (x⁻¹ : G) (1 : G) x hx
  -- h : Reachable (x⁻¹ * 1) (x⁻¹ * x)
  have h' : (SimpleGraph.mulCayley S).Reachable (x⁻¹ : G) 1 := by
    simpa [mul_one, inv_mul_cancel] using h
  exact h'.symm

/-- **Membership in the closure implies reachability.** If `g` lies in the subgroup generated
by `S`, then `g` is reachable from `1` in `mulCayley S`. -/
theorem mulCayley_reachable_one_of_mem_closure {g : G}
    (hg : g ∈ Subgroup.closure S) :
    (SimpleGraph.mulCayley S).Reachable 1 g := by
  apply Subgroup.closure_induction (p := λ g _ => (SimpleGraph.mulCayley S).Reachable 1 g)
    (mem := λ x hx => mulCayley_reachable_one_generator S hx)
    (one := SimpleGraph.Reachable.refl 1)
    (mul := λ x y _ _ hx hy => mulCayley_reachable_one_mul S hx hy)
    (inv := λ x _ hx => mulCayley_reachable_one_inv S hx)
    hg

/-- **Connectivity as reachability from the identity.** The graph `mulCayley S` is connected
iff every vertex `g ∈ G` is reachable from `1`. -/
theorem mulCayley_connected_iff_reachable_one :
    (SimpleGraph.mulCayley S).Connected ↔ ∀ g : G, (SimpleGraph.mulCayley S).Reachable 1 g := by
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  constructor
  · intro ⟨v, hv⟩ g
    have hv1 : (SimpleGraph.mulCayley S).Reachable v 1 := hv 1
    have hvg : (SimpleGraph.mulCayley S).Reachable v g := hv g
    exact hv1.symm.trans hvg
  · intro h
    exact ⟨1, h⟩

/-- **Cayley graph connected iff generators generate.** The Cayley graph `mulCayley S` is
connected if and only if `S` generates `G`, i.e. `Subgroup.closure S = ⊤`. -/
@[eval_problem]
theorem mulCayley_connected_iff_closure_eq_top :
    (SimpleGraph.mulCayley S).Connected ↔ Subgroup.closure S = ⊤ := by
  rw [mulCayley_connected_iff_reachable_one, Subgroup.eq_top_iff']
  constructor
  · intro h g
    have hg : (SimpleGraph.mulCayley S).Reachable (1 : G) g := h g
    have mem := mulCayley_inv_mul_mem_closure_of_reachable S (1 : G) g hg
    simpa using mem
  · intro h g
    exact mulCayley_reachable_one_of_mem_closure S (h g)

end Combinatorics
end LeanEval
