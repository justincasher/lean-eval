import EvalTools.Markers
import LeanEval.RepresentationTheory.SchurWeyl.Defs
import LeanEval.RepresentationTheory.SchurWeyl.Semisimple
import LeanEval.RepresentationTheory.SchurWeyl.EndTensor

/-!
Schur–Weyl duality on `V^⊗k`.

Two commuting actions on `V^⊗k`:

* `symAction`: the symmetric group `S_k` acts by permuting tensor factors.
* `glAction`: the general linear group `GL(V)` acts diagonally as `g · (v₁ ⊗ ⋯ ⊗ v_k) =
  (g v₁) ⊗ ⋯ ⊗ (g v_k)`.

Schur–Weyl duality says their images in `End(V^⊗k)` generate mutual centralizers. We state
the two directions as separate `eval_problem`s. The supporting development lives in the
`SchurWeyl/` subfolder (`Defs`, `Semisimple`, `Polarization`, `EndTensor`).
-/

namespace LeanEval
namespace RepresentationTheory

open scoped TensorProduct

/-- One direction of Schur–Weyl duality: the subalgebra generated by the `S_k` action equals
the centralizer of the subalgebra generated by the `GL(V)` action. The hypothesis
`Invertible (k! : R)` over a field is the Maschke condition for `R[S_k]`. -/
@[eval_problem]
theorem symAction_range_eq_centralizer_glAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (symAction R M k)) =
      Subalgebra.centralizer R (Set.range (glAction R M k)) := by
  let A := Algebra.adjoin R (Set.range (symAction R M k))
  let S := Set.range (symAction R M k)
  let T := Set.range (glAction R M k)
  let C_S := Subalgebra.centralizer R S
  -- Forward inclusion: A ≤ C(T)
  have h_le : A ≤ Subalgebra.centralizer R T := adjoin_symAction_le_centralizer_glAction
  -- Reverse inclusion: C(T) ≤ A
  have h_ge : Subalgebra.centralizer R T ≤ A := by
    intro x hx
    -- C(T) = C(span T)
    have h1 : Subalgebra.centralizer R T =
        Subalgebra.centralizer R (Submodule.span R T : Set (Module.End R (⨂[R]^k M))) :=
      centralizer_eq_centralizer_span T
    have hx1 : x ∈ Subalgebra.centralizer R (Submodule.span R T : Set (Module.End R (⨂[R]^k M))) := by
      rw [← h1]
      exact hx
    -- span T = span U   where U = {map(λ _, m) | m ∈ End_R V}
    let U := Set.range fun m : Module.End R M => PiTensorProduct.map (fun _ : Fin k => m)
    have hspan : Submodule.span R T = Submodule.span R U := span_range_glAction_eq_span_map
    have hx2 : x ∈ Subalgebra.centralizer R (Submodule.span R U : Set (Module.End R (⨂[R]^k M))) := by
      rw [hspan] at hx1
      exact hx1
    -- (span U : Set) = (C_S : Set)
    have hset : (C_S : Set (Module.End R (⨂[R]^k M))) =
        (Submodule.span R U : Set (Module.End R (⨂[R]^k M))) :=
      centralizer_range_symAction_eq_span_map
    have hx3 : x ∈ Subalgebra.centralizer R ((C_S : Set (Module.End R (⨂[R]^k M)))) := by
      rw [← hset] at hx2
      exact hx2
    -- Show C_S = C(A). Then double centralizer theorem gives x ∈ A.
    have hC_S_eq_CA : C_S = Subalgebra.centralizer R ((A : Set (Module.End R (⨂[R]^k M)))) := by
      apply le_antisymm
      · apply (Subalgebra.le_centralizer_iff (S := C_S) (T := A)).mpr
        refine Algebra.adjoin_le ?_
        intro g hg
        have hg_S : g ∈ S := hg
        have hgoal : g ∈ Subalgebra.centralizer R ((C_S : Set (Module.End R (⨂[R]^k M)))) := by
          rw [Subalgebra.mem_centralizer_iff]
          intro f hf
          have hf_cs : f ∈ C_S := hf
          rw [Subalgebra.mem_centralizer_iff] at hf_cs
          exact (hf_cs g hg_S).symm
        exact hgoal
      · apply Subalgebra.centralizer_le (R := R) (s := S) (t := (A : Set (Module.End R (⨂[R]^k M))))
        exact Algebra.subset_adjoin
    -- Now x ∈ C(C(A)) = A by the double centralizer theorem
    have hx4 : x ∈ Subalgebra.centralizer R ((Subalgebra.centralizer R ((A : Set (Module.End R (⨂[R]^k M)))) : Set (Module.End R (⨂[R]^k M)))) := by
      simpa [hC_S_eq_CA] using hx3
    have h_double : Subalgebra.centralizer R ((Subalgebra.centralizer R ((A : Set (Module.End R (⨂[R]^k M)))) : Set (Module.End R (⨂[R]^k M)))) = A :=
      centralizer_centralizer_adjoin_symAction
    rw [h_double] at hx4
    exact hx4
  exact le_antisymm h_le h_ge

/-- The other direction of Schur–Weyl duality: the subalgebra generated by the `GL(V)` action
equals the centralizer of the subalgebra generated by the `S_k` action. -/
@[eval_problem]
theorem glAction_range_eq_centralizer_symAction
    {R : Type*} [Field R]
    {M : Type*} [AddCommGroup M] [Module R M] [FiniteDimensional R M]
    {k : ℕ} [Invertible (k.factorial : R)] :
    Algebra.adjoin R (Set.range (glAction R M k)) =
      Subalgebra.centralizer R (Set.range (symAction R M k)) := by
  sorry

end RepresentationTheory
end LeanEval
