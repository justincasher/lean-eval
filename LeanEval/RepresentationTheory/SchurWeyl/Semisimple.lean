import Mathlib
import LeanEval.RepresentationTheory.SchurWeyl.Defs

/-!
Semisimplicity of the symmetric group algebra and the double centralizer theorem
for the image of `S_k` in `End_R(V^⊗k)`.

These declarations support the Schur–Weyl duality blueprint
`schur-weyl-duality-s-k-image-equals-centralizer-of-glv-image`.
-/

namespace LeanEval
namespace RepresentationTheory

open scoped TensorProduct

variable {R : Type*} [Field R] {M : Type*} [AddCommGroup M] [Module R M] {k : ℕ}

/-- The order `|S_k| = k!` of the symmetric group is a unit in `R`. -/
theorem isUnit_card_perm [Invertible (k.factorial : R)] :
    IsUnit ((Fintype.card (Equiv.Perm (Fin k)) : R)) := by
  sorry

/-- Small scalars are distinct: the natural-number cast `ℕ → R` is injective on `{0, …, k}`. -/
theorem natCast_injOn_Iic [Invertible (k.factorial : R)] :
    Set.InjOn (fun n : ℕ => (n : R)) (Set.Iic k) := by
  sorry

/-- Maschke: the group algebra `R[S_k]` is a semisimple ring. -/
theorem isSemisimpleRing_monoidAlgebra [Invertible (k.factorial : R)] :
    IsSemisimpleRing (MonoidAlgebra R (Equiv.Perm (Fin k))) := by
  sorry

/-- The subalgebra generated by `symAction` is the range of the algebra lift of `symAction`
through `MonoidAlgebra.lift`. -/
theorem adjoin_symAction_eq_lift_range :
    Algebra.adjoin R (Set.range (symAction R M k)) =
      (MonoidAlgebra.lift R (Module.End R (⨂[R]^k M)) (Equiv.Perm (Fin k))
          (symAction R M k)).range := by
  sorry

/-- The image of `R[S_k]` in `End_R(V^⊗k)` is a semisimple ring. -/
theorem isSemisimpleRing_adjoin_symAction [Invertible (k.factorial : R)] :
    IsSemisimpleRing (Algebra.adjoin R (Set.range (symAction R M k))) := by
  sorry

/-- `V^⊗k` is a semisimple module over `A = adjoin_R (range symAction)`. -/
theorem isSemisimpleModule_adjoin_symAction [Invertible (k.factorial : R)] :
    IsSemisimpleModule (Algebra.adjoin R (Set.range (symAction R M k))) (⨂[R]^k M) := by
  sorry

/-- The centralizer of `A = adjoin_R (range symAction)` consists exactly of the `A`-linear
endomorphisms: `f ∈ 𝓒(A)` iff `f` commutes with the action of every `a ∈ A`. -/
theorem mem_centralizer_adjoin_symAction_iff (f : Module.End R (⨂[R]^k M)) :
    f ∈ Subalgebra.centralizer R
        (Algebra.adjoin R (Set.range (symAction R M k)) : Set (Module.End R (⨂[R]^k M))) ↔
      ∀ (a : Algebra.adjoin R (Set.range (symAction R M k))) (x : ⨂[R]^k M),
        f (a • x) = a • f x := by
  sorry

/-- Jacobson density: if `T` commutes with every element of `B = 𝓒(A)`, then `T` lies in
`A = adjoin_R (range symAction)`. -/
theorem mem_adjoin_symAction_of_commute_centralizer [FiniteDimensional R M]
    [Invertible (k.factorial : R)] (T : Module.End R (⨂[R]^k M))
    (hT : ∀ b ∈ Subalgebra.centralizer R
        (Algebra.adjoin R (Set.range (symAction R M k)) : Set (Module.End R (⨂[R]^k M))),
      Commute b T) :
    T ∈ Algebra.adjoin R (Set.range (symAction R M k)) := by
  sorry

/-- The double centralizer theorem for the semisimple subalgebra `A = adjoin_R (range symAction)`:
`𝓒(𝓒(A)) = A`. -/
theorem centralizer_centralizer_adjoin_symAction [FiniteDimensional R M]
    [Invertible (k.factorial : R)] :
    Subalgebra.centralizer R
        ((Subalgebra.centralizer R
            (Algebra.adjoin R (Set.range (symAction R M k)) :
              Set (Module.End R (⨂[R]^k M)))) : Set (Module.End R (⨂[R]^k M))) =
      Algebra.adjoin R (Set.range (symAction R M k)) := by
  sorry

end RepresentationTheory
end LeanEval
