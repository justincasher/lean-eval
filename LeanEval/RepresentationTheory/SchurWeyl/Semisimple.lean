import Mathlib
import LeanEval.RepresentationTheory.SchurWeyl.Defs

/-!
Semisimplicity of the symmetric group algebra and the double centralizer theorem
for the image of `S_k` in `End_R(V^⊗k)`.

These declarations support the Schur–Weyl duality blueprint
`schur-weyl-duality-s-k-image-equals-centralizer-of-glv-image`.
-/

namespace LeanEval
namespace RepresentationTheory

open scoped TensorProduct

variable {R : Type*} [Field R] {M : Type*} [AddCommGroup M] [Module R M] {k : ℕ}

/-- The order `|S_k| = k!` of the symmetric group is a unit in `R`. -/
theorem isUnit_card_perm [Invertible (k.factorial : R)] :
    IsUnit ((Fintype.card (Equiv.Perm (Fin k)) : R)) := by
  have hcard : (Fintype.card (Equiv.Perm (Fin k)) : R) = (k.factorial : R) := by
    simp [Fintype.card_perm, Fintype.card_fin]
  rw [hcard]
  exact isUnit_of_invertible _

/-- Small scalars are distinct: the natural-number cast `ℕ → R` is injective on `{0, …, k}`. -/
theorem natCast_injOn_Iic [Invertible (k.factorial : R)] :
    Set.InjOn (fun n : ℕ => (n : R)) (Set.Iic k) := by
  sorry

/-- Maschke: the group algebra `R[S_k]` is a semisimple ring. -/
theorem isSemisimpleRing_monoidAlgebra [Invertible (k.factorial : R)] :
    IsSemisimpleRing (MonoidAlgebra R (Equiv.Perm (Fin k))) := by
  have hcard : Nat.card (Equiv.Perm (Fin k)) = k.factorial := by
    rw [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin]
  have hcard' : (Nat.card (Equiv.Perm (Fin k)) : R) = (k.factorial : R) := by
    exact congrArg (Nat.cast : ℕ → R) hcard
  have hnonzero : (Nat.card (Equiv.Perm (Fin k)) : R) ≠ 0 := by
    rw [hcard']
    have hIsUnit : IsUnit (k.factorial : R) := isUnit_of_invertible _
    exact hIsUnit.ne_zero
  haveI : NeZero (Nat.card (Equiv.Perm (Fin k)) : R) := ⟨hnonzero⟩
  infer_instance

/-- The subalgebra generated by `symAction` is the range of the algebra lift of `symAction`
through `MonoidAlgebra.lift`. -/
theorem adjoin_symAction_eq_lift_range :
    Algebra.adjoin R (Set.range (symAction R M k)) =
      (MonoidAlgebra.lift R (Module.End R (⨂[R]^k M)) (Equiv.Perm (Fin k))
          (symAction R M k)).range := by
  let f : Equiv.Perm (Fin k) →* Module.End R (⨂[R]^k M) := symAction R M k
  let φ : MonoidAlgebra R (Equiv.Perm (Fin k)) →ₐ[R] Module.End R (⨂[R]^k M) :=
    MonoidAlgebra.lift R (Module.End R (⨂[R]^k M)) (Equiv.Perm (Fin k)) f
  apply Subalgebra.ext
  intro x
  constructor
  · intro hx
    have hsub : Set.range f ⊆ (φ.range : Set (Module.End R (⨂[R]^k M))) := by
      rintro y ⟨σ, rfl⟩
      refine ⟨MonoidAlgebra.single σ (1 : R), ?_⟩
      simp [φ, MonoidAlgebra.lift_single]
    exact Algebra.adjoin_le hsub hx
  · intro hx
    rcases hx with ⟨y, hy⟩
    rw [← hy]
    have h_mem : φ y ∈ Algebra.adjoin R (Set.range f) := by
      have hy_decomp : y = Finset.sum (Finsupp.support y) (λ σ => MonoidAlgebra.single σ (y σ)) := by
        calc
          y = Finsupp.sum y MonoidAlgebra.single := (MonoidAlgebra.sum_single y).symm
          _ = Finset.sum (Finsupp.support y) (λ σ => MonoidAlgebra.single σ (y σ)) := rfl
      rw [hy_decomp, map_sum]
      simp [φ, MonoidAlgebra.lift_single, f]
      refine (Algebra.adjoin R (Set.range f)).sum_mem ?_
      intro σ hσ
      have hfσ : f σ ∈ Algebra.adjoin R (Set.range f) :=
        Algebra.subset_adjoin (Set.mem_range.mpr ⟨σ, rfl⟩)
      exact (Algebra.adjoin R (Set.range f)).smul_mem hfσ (y σ)
    exact h_mem

/-- The image of `R[S_k]` in `End_R(V^⊗k)` is a semisimple ring. -/
theorem isSemisimpleRing_adjoin_symAction [Invertible (k.factorial : R)] :
    IsSemisimpleRing (Algebra.adjoin R (Set.range (symAction R M k))) := by
  -- The algebra lift φ : R[S_k] → End_R(V^⊗k)
  let φ : MonoidAlgebra R (Equiv.Perm (Fin k)) →ₐ[R] Module.End R (⨂[R]^k M) :=
    MonoidAlgebra.lift R (Module.End R (⨂[R]^k M)) (Equiv.Perm (Fin k)) (symAction R M k)
  -- By adjoin_symAction_eq_lift_range, the adjoin equals φ.range
  have hadj_eq : Algebra.adjoin R (Set.range (symAction R M k)) = φ.range :=
    adjoin_symAction_eq_lift_range
  rw [hadj_eq]
  -- The range-restricted φ is surjective onto φ.range (by AlgHom.rangeRestrict_surjective)
  have hsurj : Function.Surjective ((φ.rangeRestrict : MonoidAlgebra R (Equiv.Perm (Fin k)) →+* φ.range) : _) :=
    AlgHom.rangeRestrict_surjective φ
  -- R[S_k] is semisimple (Maschke)
  haveI : IsSemisimpleRing (MonoidAlgebra R (Equiv.Perm (Fin k))) :=
    isSemisimpleRing_monoidAlgebra
  -- Transport semisimplicity along the surjection
  exact RingHom.isSemisimpleRing_of_surjective
    (φ.rangeRestrict : MonoidAlgebra R (Equiv.Perm (Fin k)) →+* φ.range) hsurj

/-- `V^⊗k` is a semisimple module over `A = adjoin_R (range symAction)`. -/
theorem isSemisimpleModule_adjoin_symAction [Invertible (k.factorial : R)] :
    IsSemisimpleModule (Algebra.adjoin R (Set.range (symAction R M k))) (⨂[R]^k M) := by
  haveI : IsSemisimpleRing (Algebra.adjoin R (Set.range (symAction R M k))) :=
    isSemisimpleRing_adjoin_symAction
  infer_instance

/-- The centralizer of `A = adjoin_R (range symAction)` consists exactly of the `A`-linear
endomorphisms: `f ∈ 𝓒(A)` iff `f` commutes with the action of every `a ∈ A`. -/
theorem mem_centralizer_adjoin_symAction_iff (f : Module.End R (⨂[R]^k M)) :
    f ∈ Subalgebra.centralizer R
        (Algebra.adjoin R (Set.range (symAction R M k)) : Set (Module.End R (⨂[R]^k M))) ↔
      ∀ (a : Algebra.adjoin R (Set.range (symAction R M k))) (x : ⨂[R]^k M),
        f (a • x) = a • f x := by
  let s : Set (Module.End R (⨂[R]^k M)) :=
    (Algebra.adjoin R (Set.range (symAction R M k)) : Set (Module.End R (⨂[R]^k M)))
  constructor
  · intro hf a x
    have h_comm : ∀ g ∈ s, g * f = f * g := by
      rwa [Subalgebra.mem_centralizer_iff] at hf
    have ha_mem : (a : Module.End R (⨂[R]^k M)) ∈ s := a.property
    have h_eq : (a : Module.End R (⨂[R]^k M)) * f = f * (a : Module.End R (⨂[R]^k M)) :=
      h_comm (a : Module.End R (⨂[R]^k M)) ha_mem
    calc
      f (a • x) = f (((a : Module.End R (⨂[R]^k M))) x) := rfl
      _ = (f * (a : Module.End R (⨂[R]^k M))) x := rfl
      _ = ((a : Module.End R (⨂[R]^k M)) * f) x := by rw [h_eq]
      _ = (a : Module.End R (⨂[R]^k M)) (f x) := rfl
      _ = a • f x := rfl
  · intro h
    rw [Subalgebra.mem_centralizer_iff]
    intro g hg
    apply LinearMap.ext
    intro x
    calc
      (g * f) x = g (f x) := rfl
      _ = ((⟨g, hg⟩ : Algebra.adjoin R (Set.range (symAction R M k))) : Module.End R (⨂[R]^k M)) (f x) := rfl
      _ = (⟨g, hg⟩ : Algebra.adjoin R (Set.range (symAction R M k))) • f x := rfl
      _ = f ((⟨g, hg⟩ : Algebra.adjoin R (Set.range (symAction R M k))) • x) := (h ⟨g, hg⟩ x).symm
      _ = f (g x) := rfl
      _ = (f * g) x := rfl

/-- Jacobson density: if `T` commutes with every element of `B = 𝓒(A)`, then `T` lies in
`A = adjoin_R (range symAction)`. -/
theorem mem_adjoin_symAction_of_commute_centralizer [FiniteDimensional R M]
    [Invertible (k.factorial : R)] (T : Module.End R (⨂[R]^k M))
    (hT : ∀ b ∈ Subalgebra.centralizer R
        (Algebra.adjoin R (Set.range (symAction R M k)) : Set (Module.End R (⨂[R]^k M))),
      Commute b T) :
    T ∈ Algebra.adjoin R (Set.range (symAction R M k)) := by
  sorry

/-- The double centralizer theorem for the semisimple subalgebra `A = adjoin_R (range symAction)`:
`𝓒(𝓒(A)) = A`. -/
theorem centralizer_centralizer_adjoin_symAction [FiniteDimensional R M]
    [Invertible (k.factorial : R)] :
    Subalgebra.centralizer R
        ((Subalgebra.centralizer R
            (Algebra.adjoin R (Set.range (symAction R M k)) :
              Set (Module.End R (⨂[R]^k M)))) : Set (Module.End R (⨂[R]^k M))) =
      Algebra.adjoin R (Set.range (symAction R M k)) := by
  let sA := Algebra.adjoin R (Set.range (symAction R M k))
  have hA : sA ≤ Subalgebra.centralizer R
      ((Subalgebra.centralizer R (sA : Set (Module.End R (⨂[R]^k M)))) :
        Set (Module.End R (⨂[R]^k M))) :=
    Subalgebra.le_centralizer_centralizer (s := sA)
  apply le_antisymm
  · intro T hT
    rw [Subalgebra.mem_centralizer_iff] at hT
    apply mem_adjoin_symAction_of_commute_centralizer T
    intro b hb
    exact hT b hb
  · exact hA

end RepresentationTheory
end LeanEval
